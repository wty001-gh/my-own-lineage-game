      if (ps >= 4) inRadius(u.cell, 2, enemySide(u)).forEach(function (e) { e.slowT = Math.max(e.slowT || 0, 2); });
      if (ps >= 5) u.shield += Math.round(u.mhp * BAL.sk.knightShield * m * 0.35);
    } else if (cls === 'royal') {
