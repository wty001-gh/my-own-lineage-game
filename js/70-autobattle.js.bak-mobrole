  if (it.itemKey) { if (R.gold < 3) { hint('金幣唔夠'); return; } if ((R.items || []).length >= STASH_MAX) { hint('背包滿'); return; } R.gold -= 3; R.shop[i] = null; gainItem(mkComp(it.itemKey), '酒館購買：'); render(); return; }
