  else if (f === 'ignaraFear' && t) { inRadius(t.cell, 1, t.side).forEach(function (e) { if (e.burn) e.burn.t = Math.max(e.burn.t, 4); e.fearT = Math.max(e.fearT || 0, 1.2); }); }
