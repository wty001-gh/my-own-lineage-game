  /* 滿血時：吸血溢出轉護盾（上限 15% mhp／次），唔係食假綠字——玩家先睇得出有實裝 */
  if (opt.vamp && amt > 0) {
    var sh = Math.round(Math.min(amt, tgt.mhp * 0.15));
    if (sh > 0) {
      tgt.shield = (tgt.shield || 0) + sh;
      if (src) stOf(src).heal += sh;
      floatTxt(tgt, '吸血🛡+' + sh, '#e879f9');
      return sh;
    }
  }
  return 0;
}
